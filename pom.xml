<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ── ИДЕНТИФИКАЦИЯ ПРОЕКТА ──────────────────────────────────────────── -->
    <groupId>com.saucedemo</groupId>
    <artifactId>saucedemo-autotests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>SauceDemo Autotests — Java + Selenium + TestNG</name>

    <!-- ── ВЕРСИИ ЗАВИСИМОСТЕЙ ────────────────────────────────────────────── -->
    <properties>
        <java.version>11</java.version>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Selenium — управление браузером -->
        <selenium.version>4.18.1</selenium.version>

        <!-- WebDriverManager — автоматическая загрузка драйвера браузера -->
        <webdrivermanager.version>5.7.0</webdrivermanager.version>

        <!-- TestNG — фреймворк для тестов -->
        <testng.version>7.9.0</testng.version>

        <!-- ExtentReports — красивые HTML-отчёты -->
        <extentreports.version>5.1.1</extentreports.version>
    </properties>

    <!-- ── ЗАВИСИМОСТИ ────────────────────────────────────────────────────── -->
    <dependencies>

        <!-- Selenium WebDriver: управляет браузером из кода -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- WebDriverManager: сам скачивает нужный ChromeDriver/GeckoDriver -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>${webdrivermanager.version}</version>
        </dependency>

        <!-- TestNG: запуск тестов, аннотации @Test, @BeforeMethod и т.д. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- ExtentReports: HTML-отчёт с шагами, скриншотами, статистикой -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

    </dependencies>

    <!-- ── ПЛАГИНЫ СБОРКИ ─────────────────────────────────────────────────── -->
    <build>
        <plugins>

            <!-- Компилятор Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>

            <!-- Maven Surefire: запускает TestNG тесты через mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Указываем наш testng.xml с настройками запуска -->
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
