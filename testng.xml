<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    testng.xml — конфигурация тестового набора.
    Здесь определяем: какие тесты запускать, в каком порядке,
    сколько потоков использовать.
-->
<suite name="SauceDemo Test Suite" verbose="1" parallel="false">

    <!-- ── ПАРАМЕТРЫ (доступны во всех тестах) ──────────────────────────── -->
    <parameter name="browser"  value="chrome"/>
    <parameter name="headless" value="false"/>
    <parameter name="baseUrl"  value="https://www.saucedemo.com"/>

    <!-- ── 1. АВТОРИЗАЦИЯ ───────────────────────────────────────────────── -->
    <test name="Login Tests">
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <!-- ── 2. КОРЗИНА ───────────────────────────────────────────────────── -->
    <test name="Cart Tests">
        <classes>
            <class name="com.saucedemo.tests.CartTest"/>
        </classes>
    </test>

    <!-- ── 3. ОФОРМЛЕНИЕ ЗАКАЗА ─────────────────────────────────────────── -->
    <test name="Checkout Tests">
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
